SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost 127.0.0.1
DEBUG=0

# Postgres/TimescaleDB is required always — there's no SQLite fallback (see
# CLAUDE.md). Used directly by the `db` service in docker-compose.yml to
# initialize the database, and by DATABASE_URL below to connect to it.
POSTGRES_DB=osm_monitor
POSTGRES_USER=osm_monitor
POSTGRES_PASSWORD=change-me

# Standard DSN Django (via dj-database-url) connects with. Host "db" is the
# docker-compose service name — leave it as-is when running via Compose.
DATABASE_URL=postgresql://osm_monitor:change-me@db:5432/osm_monitor

# Absolute host directory holding the Postgres data files (bind-mounted into
# the db service). Under Colima it must be inside a directory shared into the
# VM (see README's "Fresh machine" section). Create it before the first deploy.
PGDATA_DIR=/Users/you/osm-monitor-data/pgdata

# Optional: Datadog (APM, logs, Postgres Database Monitoring). Uncomment to
# layer docker-compose.datadog.yml onto every `docker compose` command.
# DD_POSTGRES_PASSWORD must be set before the database is first initialized
# (db/init/01-datadog.sh creates the `datadog` role from it).
# COMPOSE_FILE=docker-compose.yml:docker-compose.datadog.yml
# DD_API_KEY=your-datadog-api-key
# DD_SITE=datadoghq.com
# DD_POSTGRES_PASSWORD=change-me
