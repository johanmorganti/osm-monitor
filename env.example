SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost 127.0.0.1
DEBUG=0

# Absolute host directory for the app's own state: a SQLite file (the pollers'
# positions, Django's tables), shared by web and both pollers. Under Colima it
# must be inside a directory shared into the VM (see docs/DEPLOYMENT.md).
# Create it before the first deploy.
SQLITE_DIR=/Users/you/osm-monitor-data/sqlite

# ClickHouse: the analytics database (holds every changeset, answers the API).
CLICKHOUSE_PASSWORD=change-me
# Absolute host directory for its data files, like SQLITE_DIR. Create it first.
CLICKHOUSE_DATA_DIR=/Users/you/osm-monitor-data/clickhouse

# Analytics backend serving the API (clickhouse, or clickhouse_raw without its
# rollups), and storage writers ingestion feeds (comma-separated, primary first).
# ANALYTICS_BACKEND=clickhouse
# INGEST_BACKENDS=clickhouse
# ANALYTICS_OVERRIDE_TOKEN=   # internal: lets requests pick a backend via X-Analytics-Backend + X-Analytics-Token

# Optional: Datadog (APM, logs, ClickHouse Database Monitoring). Uncomment to
# layer docker-compose.datadog.yml onto every `docker compose` command.
# COMPOSE_FILE=docker-compose.yml:docker-compose.datadog.yml
# DD_API_KEY=your-datadog-api-key
# DD_SITE=datadoghq.com
# DD_CLICKHOUSE_PASSWORD=change-me   # monitoring user clickhouse_migrate creates
# Optional: Datadog RUM (browser). Loaded only when both of these are set.
# DD_RUM_APPLICATION_ID=
# DD_RUM_CLIENT_TOKEN=
# DD_RUM_REMOTE_CONFIGURATION_ID=   # fetched via DD_RUM_PROXY_URL/config.json when a proxy is set; delays RUM start
# DD_RUM_PROXY_URL=https://rum-proxy.example.com   # optional first-party proxy: intake, the SDK at /sdk.js, remote config at /config.json
# DD_RUM_SERVICE=osm-monitor-frontend
# DD_RUM_SESSION_REPLAY_SAMPLE_RATE=20
